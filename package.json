    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
